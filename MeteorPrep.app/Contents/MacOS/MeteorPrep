#!/bin/bash
# MeteorPrep one-click launcher (app bundle).
# Lives inside the unzipped METEORPREP folder — it launches the GUI from
# the folder that contains this app, so keep them together.
set -u
LOG=/tmp/meteorprep_setup.log
# every module a real run needs — the window, the RAW decoder, the
# image writers.  Probing only for PySide6 and the package itself
# passed on an install with no rawpy, and first-time setup was
# skipped on exactly the machine that needed it.
NEEDS="import PySide6, rawpy, cv2, tifffile, PIL, astropy, meteorprep.pipeline"

say_alert() {   # title, message
    command -v osascript >/dev/null 2>&1 || return 0
    osascript -e "display alert \"$1\" message \"$2\"" >/dev/null 2>&1
}

# Never let Python scan a directory we cannot read (see translocation
# below): stand in the home folder until the real one is known.
cd "$HOME" 2>/dev/null || cd /

HERE="$(cd "$(dirname "$0")/../../.." 2>/dev/null && pwd)" || HERE=""

# macOS App Translocation: an app opened straight out of a download runs
# from a random READ-ONLY copy under /private/var/.../AppTranslocation/,
# with none of its sibling files.  Anything that touches that directory
# fails with "Result too large".  Find the real unzipped folder instead.
if [ -z "$HERE" ] || [ ! -f "$HERE/meteorprep/__init__.py" ]; then
    HERE=""
    for d in $(ls -td "$HOME"/Downloads/METEORPREP-* "$HOME"/Desktop/METEORPREP-* \
                      "$HOME"/Documents/METEORPREP-* "$HOME"/METEORPREP-* \
                      "$HOME"/Downloads/METEORPREP "$HOME"/Desktop/METEORPREP \
                      2>/dev/null); do
        if [ -f "$d/meteorprep/__init__.py" ]; then HERE="$d"; break; fi
    done
    if [ -z "$HERE" ]; then
        say_alert "Move the folder first" \
"macOS is running this app from a temporary copy, so it cannot see its own files. Drag the whole METEORPREP folder to your Desktop, then open MeteorPrep from there. (Or double-click 'Start MeteorPrep.command' in the folder — that always works.)"
        exit 1
    fi
    # found it: clear the download quarantine so the next double-click
    # runs in place instead of being translocated again
    xattr -dr com.apple.quarantine "$HERE" 2>/dev/null || true
fi
cd "$HERE" || exit 1

# macOS guards Downloads (and Desktop/Documents) with a privacy gate: a
# process that is refused sees "Operation not permitted" on the most
# basic reads — one real machine died inside pip's very first line, in
# os.getcwd().  Probe with an actual read of our own files and, if the
# gate is closed, say the fix in words instead of a traceback.
if ! head -c 1 "$HERE/meteorprep/__init__.py" >/dev/null 2>&1; then
    say_alert "macOS is protecting this folder" \
"macOS will not let MeteorPrep read its own files in $HERE. The fix takes 30 seconds: drag the whole METEORPREP folder into your home folder (the one with the house icon) or into Applications, then open MeteorPrep from there."
    exit 1
fi

# Candidate interpreters, best first.  A Mac can easily carry several
# Pythons; the components may already be installed in ANY of them, so
# look for one that is ready before trying to install anything.
PRIVATE_PY_DIR="$HOME/Library/Application Support/MeteorPrep/python"
CANDIDATES=""
# a Python this app downloaded for itself on an earlier launch wins: it
# is ours, nothing else touches it, and it never fights Homebrew
[ -x "$PRIVATE_PY_DIR/bin/python3" ] && \
    CANDIDATES="$CANDIDATES $PRIVATE_PY_DIR/bin/python3"
for v in 3.13 3.12 3.11 3.14; do
    p="/Library/Frameworks/Python.framework/Versions/$v/bin/python3"
    [ -x "$p" ] && CANDIDATES="$CANDIDATES $p"
done
for p in "$(command -v python3 || true)" /opt/homebrew/bin/python3 \
         /usr/local/bin/python3; do
    [ -n "$p" ] && [ -x "$p" ] && CANDIDATES="$CANDIDATES $p"
done

# 1) already-working interpreter?  launch straight away, no setup at all
for p in $CANDIDATES; do
    if "$p" -c "$NEEDS" >/dev/null 2>&1; then
        exec "$p" -m meteorprep.gui
    fi
done

# 2) nothing ready: install into the best candidate we have
PY=""
for p in $CANDIDATES; do PY="$p"; break; done
if [ -z "$PY" ]; then
    # No Python on this Mac at all.  Rather than sending a person off to
    # python.org, fetch a self-contained one into this app's own folder
    # under Application Support — no admin password, nothing installed
    # system-wide, removable by deleting one folder.
    command -v osascript >/dev/null 2>&1 && osascript -e \
      'display dialog "First-time setup: MeteorPrep will download its own copy of Python (about 45 MB) into its Application Support folder. Nothing is installed system-wide. Press OK to continue." buttons {"OK", "Cancel"} default button 1' \
      >/dev/null 2>&1 || exit 1
    ARCH="$(uname -m)"
    case "$ARCH" in
        arm64) PBS_ARCH="aarch64" ;;
        *)     PBS_ARCH="x86_64" ;;
    esac
    PBS_URL="https://github.com/astral-sh/python-build-standalone/releases/download/20260825/cpython-3.12.14+20260825-$PBS_ARCH-apple-darwin-install_only.tar.gz"
    mkdir -p "$PRIVATE_PY_DIR.download" || exit 1
    echo "=== downloading $PBS_URL" >> "$LOG" 2>&1
    if curl -fL --retry 3 -o "$PRIVATE_PY_DIR.download/py.tar.gz" "$PBS_URL" \
            >> "$LOG" 2>&1 \
       && tar -xzf "$PRIVATE_PY_DIR.download/py.tar.gz" \
              -C "$PRIVATE_PY_DIR.download" >> "$LOG" 2>&1 \
       && rm -rf "$PRIVATE_PY_DIR" \
       && mv "$PRIVATE_PY_DIR.download/python" "$PRIVATE_PY_DIR"; then
        rm -rf "$PRIVATE_PY_DIR.download"
        PY="$PRIVATE_PY_DIR/bin/python3"
    else
        rm -rf "$PRIVATE_PY_DIR.download"
        say_alert "Download did not finish" \
"MeteorPrep could not download Python (no internet?). Either connect and try again, or install Python 3 yourself from python.org and double-click MeteorPrep again."
        exit 1
    fi
fi

command -v osascript >/dev/null 2>&1 && osascript -e \
  'display dialog "First-time setup: MeteorPrep will install its components now. This takes a few minutes — press OK, then wait for the window to appear." buttons {"OK"} default button 1' >/dev/null 2>&1

{ echo "=== using: $PY"; "$PY" --version; echo "=== folder: $HERE"; } \
    > "$LOG" 2>&1
# pip reads its working directory before doing anything else, and on a
# privacy-guarded folder that single call is what used to kill setup —
# so pip always runs from the home folder and is handed the absolute
# path instead
cd "$HOME" 2>/dev/null || cd /
if "$PY" -m pip install --upgrade pip >> "$LOG" 2>&1; then :; fi
if ! "$PY" -m pip install "$HERE"'[gui]' >> "$LOG" 2>&1; then
    # retry once for the classic macOS case: system-managed Python that
    # refuses to install into itself
    "$PY" -m pip install --user "$HERE"'[gui]' >> "$LOG" 2>&1 || true
fi
cd "$HERE" || exit 1

if "$PY" -c "$NEEDS" >/dev/null 2>&1; then
    exec "$PY" -m meteorprep.gui
fi

# still not working: show the tail of the log right in the dialog and
# open the full log, so the problem is visible instead of cryptic
tail -n 14 "$LOG" 2>/dev/null | tr '"' "'" > /tmp/meteorprep_setup_tail.txt
command -v osascript >/dev/null 2>&1 && osascript -e \
  'display alert "Setup did not finish" message (read POSIX file "/tmp/meteorprep_setup_tail.txt")' >/dev/null 2>&1
open -e "$LOG" 2>/dev/null
exit 1
